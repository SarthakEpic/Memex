# ═══════════════════════════════════════════════════════════════════════════
# Memex — Docker Compose deployment (Oracle Cloud VM / any Docker host)
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy to the repo root as .env, then fill in every value:
#   cp deploy/.env.example .env
#
# The compose file injects DATABASE_URL itself (pointing at the db service),
# so you do NOT set DATABASE_URL here.
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. POSTGRES (compose services)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER="memex"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="memex"

# ─────────────────────────────────────────────────────────────────────────────
# 2. PUBLIC URL (Caddy provisions automatic HTTPS for this domain)
# ─────────────────────────────────────────────────────────────────────────────
# Point a DNS A record — e.g. a free DuckDNS subdomain — at the VM's public
# IP first, then set both values to the same domain.
MEMEX_DOMAIN="memex.example.duckdns.org"
APP_BASE_URL="https://memex.example.duckdns.org"

# ─────────────────────────────────────────────────────────────────────────────
# 3. APP SECRETS (required)
# ─────────────────────────────────────────────────────────────────────────────
# Encrypts stored email credentials. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY="replace-with-a-long-random-secret-before-production"

# Bearer token required by /api/cron/scheduled when called by the scheduler
# container or any external cron.
CRON_SECRET="replace-with-a-long-random-secret"

# ─────────────────────────────────────────────────────────────────────────────
# 4. AI PROVIDER (required for chat, email analysis, drafting)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER="gemini"
GEMINI_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# 5. OPTIONAL — platform SMTP for verification / password-reset emails
# ─────────────────────────────────────────────────────────────────────────────
REQUIRE_EMAIL_VERIFICATION="false"
APP_EMAIL_FROM=""
AUTH_SMTP_HOST=""
AUTH_SMTP_PORT="587"
AUTH_SMTP_USER=""
AUTH_SMTP_PASSWORD=""
AUTH_SMTP_SECURE="false"

# ─────────────────────────────────────────────────────────────────────────────
# 6. OPTIONAL — email OAuth (Gmail / Outlook connect-without-password)
#    Register the callback URLs from docs/email-oauth-setup.md first.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# 7. SCHEDULER
# ─────────────────────────────────────────────────────────────────────────────
# How often the scheduler container calls /api/cron/scheduled.
CRON_SCHEDULE="*/10 * * * *"
