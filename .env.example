# ═══════════════════════════════════════════════════════════════════════════
# Memex — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. DATABASE (required)
# ─────────────────────────────────────────────────────────────────────────────
#
# SQLite (default — for local development, no setup needed):
DATABASE_URL="file:./db/custom.db"

# Required in production. Used to encrypt OAuth tokens, advanced IMAP app
# passwords, and other local secrets. Use a long random value (32+ chars).
ENCRYPTION_KEY="replace-with-a-long-random-secret-before-production"

# Required in production. Used to generate password reset and email
# verification links. Example: https://your-app.vercel.app
APP_BASE_URL="http://localhost:3000"

# Optional stricter production auth. If true, new users must verify email
# before signing in. Requires AUTH_SMTP_* below.
REQUIRE_EMAIL_VERIFICATION="false"

# Optional platform SMTP for account verification and password reset emails.
# This is separate from user-connected inbox SMTP settings.
APP_EMAIL_FROM="Memex <no-reply@example.com>"
AUTH_SMTP_HOST=""
AUTH_SMTP_PORT="587"
AUTH_SMTP_USER=""
AUTH_SMTP_PASSWORD=""
AUTH_SMTP_SECURE="false"

# Optional secret for external cron callers. Vercel Cron can hit the route
# without this; for GitHub Actions or cron-job.org, send Authorization: Bearer.
CRON_SECRET=""

# Local development uses memory throttling. Use "database" for single-database
# production deployments where multiple Node processes need shared limits.
RATE_LIMIT_BACKEND="memory"
#
# PostgreSQL (for production / cloud deployment):
#   1. Run: npm run db:use-postgres
#   2. Set DATABASE_URL to your Postgres connection string:
# DATABASE_URL="postgresql://user:password@localhost:5432/memex"
#   Or for hosted Postgres (Neon, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/memex?sslmode=require"
#
# ─────────────────────────────────────────────────────────────────────────────
# 2. AI PROVIDER (required for AI features — chat, email drafting, analysis)
# ─────────────────────────────────────────────────────────────────────────────
#
# Choose ONE provider. Each has a free tier.
#
# ── Option A: Google Gemini (RECOMMENDED — most generous free tier) ──────────
# Free tier: 1500 requests/day, 1M tokens/min
# Get key:  https://aistudio.google.com/app/apikey
#
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
#
# ── Option B: Groq (fastest — Llama 3.3 70B) ─────────────────────────────────
# Free tier: 30 RPM, ~1000 requests/day
# Get key:  https://console.groq.com/keys
#
# AI_PROVIDER="groq"
# GROQ_API_KEY=""
#
# ── Option C: OpenRouter (aggregator — access many models) ───────────────────
# Free tier: some models are free (Llama, Mistral, Gemma)
# Get key:  https://openrouter.ai/keys
#
# AI_PROVIDER="openrouter"
# OPENROUTER_API_KEY=""
#
# ── Option D: OpenAI (paid — best quality) ───────────────────────────────────
# Get key:  https://platform.openai.com/api-keys
#
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
#
# ── Option E: Ollama (100% free, local, unlimited — needs good hardware) ─────
# Install: https://ollama.ai
# Pull a model: ollama pull llama3.1:8b
#
# AI_PROVIDER="ollama"
# OLLAMA_HOST="http://localhost:11434"
#
# ── Option F: Custom (any OpenAI-compatible provider) ────────────────────────
# AI_PROVIDER="custom"
# AI_BASE_URL="https://your-provider.com/v1"
# AI_API_KEY="your-key"
# AI_MODEL="your-model-name"
#
# ─────────────────────────────────────────────────────────────────────────────
# 3. AI MODEL & PARAMETERS (optional — overrides provider defaults)
# ─────────────────────────────────────────────────────────────────────────────
#
# Override the default model for your chosen provider:
# AI_MODEL="gemini-1.5-pro"
#
# Default sampling temperature (0 = deterministic, 1 = creative):
# AI_TEMPERATURE="0.4"
#
# Default max output tokens per response:
# AI_MAX_TOKENS="800"
#
# ─────────────────────────────────────────────────────────────────────────────
# 4. EMAIL (optional — for real email sending/receiving)
# ─────────────────────────────────────────────────────────────────────────────
#
# Composing and local saving work without a connected account. The primary
# connection method is OAuth: users sign in on Google or Microsoft and Memex
# stores encrypted tokens, never their mailbox password.
#
# Register the exact callback URLs shown in docs/email-oauth-setup.md, then add
# these server-only values. Do NOT use NEXT_PUBLIC_ for either client secret.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
#
# Advanced IMAP/SMTP is a fallback for providers without OAuth support. Its
# app-specific credentials are encrypted with ENCRYPTION_KEY before storage.
#
# ─────────────────────────────────────────────────────────────────────────────
# 5. NOTES
# ─────────────────────────────────────────────────────────────────────────────
#
# - This file (.env.example) is safe to commit to git — it has no real secrets.
# - The .env file is gitignored and should NEVER be committed.
# - If no AI_PROVIDER is set, the app falls back to the sandbox AI (only works
#   in the development sandbox, not on your own machine or in production).
# - The Settings page shows the current AI provider status and guides you
#   through configuration if something is missing.
